# ============================================================
# GlobalIntelligence — Environment Variables (example)
# کپی کنید به .env و مقادیر را تنظیم کنید.
# هیچ API Key واقعی را داخل این فایل یا Git قرار ندهید.
# ============================================================

# --- Application ---
APP_NAME=GlobalIntelligence
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
TZ=UTC

# --- Security ---
# با دستور زیر بسازید: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# کلید API برای محافظت از endpointها (هدر X-API-Key)
# در production الزامی است. بسازید: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mock / Offline mode ---
# اگر true باشد، سیستم بدون هیچ API پولی و بدون اینترنت (با داده نمونه) اجرا می‌شود.
MOCK_MODE=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=globalintelligence
POSTGRES_USER=gi_user
POSTGRES_PASSWORD=change-me-in-production

# --- Redis (فقط زمانی که واقعاً نیاز باشد فعال شود) ---
# REDIS_URL=redis://redis:6379/0

# --- AI Gateway: Providerها (همه Optional هستند) ---
# نام هیچ Provider در منطق اصلی Hard-code نمی‌شود؛ فقط از طریق این متغیرها فعال می‌شوند.
# در production، MOCK_MODE=false و AI_DEFAULT_PROVIDER را روی یک Provider واقعی بگذارید.
AI_DEFAULT_PROVIDER=mock

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Groq / Cloudflare (Step 8; یا از پنل تنظیمات ذخیره می‌شوند) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Dashboard login (Step 8; پیش‌فرض لوکال admin/admin — در production عوض کنید) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Settings panel encryption (Step 8; بوت‌استرپ — در .env می‌ماند) ---
# ساخت: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# بدون این کلید، ذخیره‌ی Provider-Key از رابط رد می‌شود. گمش نکنید (بکاپ جدا).
APP_ENCRYPTION_KEY=
# base_url خصوصی برای Provider سفارشی (پیش‌فرض false؛ ضد SSRF)
ALLOW_PRIVATE_BASE_URL=false

# --- AI Gateway tuning ---
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_ENABLE_COST_TRACKING=true

# --- Debate Engine (Step 3; فقط placeholder، بدون کلید) ---
DEBATE_MAX_TOKENS_PER_RUN=60000
DEBATE_DAILY_BUDGET_USD=5.0
DEBATE_MAX_ROUNDS=2
DEBATE_CALL_GAP_SECONDS=0
# هر agent می‌تواند مدل متفاوت داشته باشد (خالی = مدل پیش‌فرض همان Provider)
DEBATE_MODEL_BULL=
DEBATE_MODEL_BEAR=
DEBATE_MODEL_MACRO=
DEBATE_MODEL_GEO=
DEBATE_MODEL_CRITIC=
DEBATE_MODEL_REPORT=

# --- n8n ---
# توجه: N8N_BASIC_AUTH_* در n8n نسخه‌ی ۱+ حذف شده و دیگر اثر ندارد.
# احراز هویت n8n را از طریق اولین owner setup یا N8N_USER_MANAGEMENT انجام دهید.
N8N_ENCRYPTION_KEY=change-me-in-production

# --- Deduplication (Phase 9) ---
DEDUP_ON_INGEST=false
DEDUP_NEAR_THRESHOLD=0.7
DEDUP_WINDOW=1000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Data collection ---
# حداقل فاصله بین درخواست‌ها به هر منبع (ثانیه) — احترام به rate limit منابع
SOURCE_MIN_INTERVAL_SECONDS=60
USER_AGENT=GlobalIntelligenceBot/0.1 (+https://example.local; contact@example.local)

# --- Source bot (ربات مرکزی استخراج/dedup/اولویت) ---
SOURCE_BOT_TIMEOUT=20
SOURCE_BOT_MAX_BYTES=5000000
SOURCE_BOT_MAX_CSV_BYTES=10000000
SOURCE_BOT_MAX_PAGES=20
SOURCE_BOT_MAX_DEPTH=2
SOURCE_BOT_CONCURRENCY=4
SOURCE_BOT_DELAY=1.0
SOURCE_BOT_MAX_REDIRECTS=3
SOURCE_BOT_MAX_RETRIES=2
SOURCE_BOT_INTERVAL=3600
SOURCE_BOT_TH_P0=90
SOURCE_BOT_TH_P1=75
SOURCE_BOT_TH_P2=50
SOURCE_BOT_TH_P3=25
SOURCE_BOT_AI_MIN_CONF=0.55
SOURCE_BOT_AI_MARGIN=7.0
SOURCE_BOT_AI_ENABLED=true

# --- Docker build mirrors (برای شبکه‌های محدود؛ پیش‌فرض PyPI رسمی است) ---
# اگر دانلود از files.pythonhosted.org مسدود/ناپایدار بود، آینه را اینجا ست کنید.
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
# NPM_REGISTRY=https://registry.npmjs.org

# --- AI token budget: SAMPLE task caps (non-operational; all commented) ---
# Budget stays OFF until AI_DAILY_TOKEN_BUDGET is set explicitly elsewhere.
# Values below are starting points from Step 1D.6 audit, NOT validated limits.
# Keys must match real Gateway task names exactly; debate agents share
# the debate_agent cap; unknown tasks fail closed when budget is on.
# AI_TASK_MAX_TOKENS={"classify_article": 1500, "extract_claims": 1000, "extract_event": 800, "extract_evidence": 1000, "extract_relations": 800, "debate_agent": 1500, "debate_report": 1500}
