# ============================================================
# GlobalIntelligence — Environment Variables (example)
# کپی کنید به .env و مقادیر را تنظیم کنید.
# هیچ API Key واقعی را داخل این فایل یا Git قرار ندهید.
# ============================================================

# --- Application ---
APP_NAME=GlobalIntelligence
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
TZ=UTC

# --- Security ---
# با دستور زیر بسازید: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mock / Offline mode ---
# اگر true باشد، سیستم بدون هیچ API پولی و بدون اینترنت (با داده نمونه) اجرا می‌شود.
MOCK_MODE=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=globalintelligence
POSTGRES_USER=gi_user
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://gi_user:change-me-in-production@postgres:5432/globalintelligence

# --- Redis (فقط زمانی که واقعاً نیاز باشد فعال شود) ---
# REDIS_URL=redis://redis:6379/0

# --- AI Gateway: Providerها (همه Optional هستند) ---
# نام هیچ Provider در منطق اصلی Hard-code نمی‌شود؛ فقط از طریق این متغیرها فعال می‌شوند.
AI_DEFAULT_PROVIDER=mock

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- AI Gateway tuning ---
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_ENABLE_COST_TRACKING=true

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-in-production
N8N_ENCRYPTION_KEY=change-me-in-production
N8N_WEBHOOK_URL=http://backend:8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Data collection ---
# حداقل فاصله بین درخواست‌ها به هر منبع (ثانیه) — احترام به rate limit منابع
SOURCE_MIN_INTERVAL_SECONDS=60
USER_AGENT=GlobalIntelligenceBot/0.1 (+https://example.local; contact@example.local)
