{
  "name": "GI — Hourly Markets & Macro",
  "id": "gi-hourly-markets",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-markets",
      "name": "Schedule Trigger (1h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/markets/fetch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "step-markets",
      "name": "1. Fetch markets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/economic/fetch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "step-economic",
      "name": "2. Fetch economic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/world-state/build",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "step-worldstate",
      "name": "3. Build world state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    }
  ],
  "connections": {
    "Schedule Trigger (1h)": {
      "main": [
        [
          {
            "node": "1. Fetch markets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Fetch markets": {
      "main": [
        [
          {
            "node": "2. Fetch economic",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Fetch economic": {
      "main": [
        [
          {
            "node": "3. Build world state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
