          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "step-selfeval",
      "name": "4. Self evaluation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    }
